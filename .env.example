# Supabase (Server-side only; never use NEXT_PUBLIC_ for service role key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend Email Notifications
RESEND_API_KEY=re_your_resend_api_key
LEAD_NOTIFY_EMAIL=notifications@yourdomain.com
LEAD_FROM_EMAIL=Apex Tutors <onboarding@resend.dev>

# WhatsApp Notifications
# Provider switch: "callmebot" | "meta" | "" (leave empty to skip)
WHATSAPP_PROVIDER=callmebot
WHATSAPP_NOTIFY_NUMBER=+923001234567

# CallMeBot configuration (required if WHATSAPP_PROVIDER=callmebot)
CALLMEBOT_API_KEY=your_callmebot_api_key

# WhatsApp Cloud API / Meta (required if WHATSAPP_PROVIDER=meta)
META_WA_TOKEN=your_meta_system_user_token
META_WA_PHONE_NUMBER_ID=your_meta_phone_number_id
